#!/bin/bash
# Build script for Vagrant VM
# Usage: ./vm-build [vm_name] [clean|test|install|status|logs|build]

set -e

VM_NAME="${1:-ubuntu_dev}"
VM_DIR="automation/vagrant/virtuals/$VM_NAME"
PROJECT_DIR="/opt/simple-metricd"
BUILD_USER="simple-metricd"
CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DENABLE_TESTS=ON -DENABLE_SSL=ON -DENABLE_SQLITE=ON"

if [ ! -d "$VM_DIR" ]; then
    echo "VM directory $VM_DIR not found"
    echo "Available VMs: ubuntu_dev, centos_dev"
    exit 1
fi

cd "$VM_DIR"

if ! vagrant status | grep -q "running"; then
    echo "Starting Vagrant VM..."
    vagrant up
fi

echo "Syncing files to VM..."
vagrant rsync

remote() {
    vagrant ssh -c "$1"
}

case "${2:-build}" in
    clean)
        echo "Cleaning build directory..."
        remote "cd $PROJECT_DIR && sudo -u $BUILD_USER rm -rf build && sudo -u $BUILD_USER mkdir -p build"
        ;;
    test)
        echo "Running tests..."
        remote "cd $PROJECT_DIR/build && sudo -u $BUILD_USER ctest --output-on-failure"
        ;;
    install)
        echo "Installing service files (does not start)..."
        remote "sudo cmake --install $PROJECT_DIR/build"
        remote "sudo mkdir -p /etc/simple-metricd/tls /var/lib/simple-metricd /var/log/simple-metricd"
        remote "sudo cp $PROJECT_DIR/deployment/systemd/simple-metricd.service /etc/systemd/system/simple-metricd.service"
        remote "if [ ! -f /etc/simple-metricd/simple-metricd.conf ]; then sudo cp $PROJECT_DIR/config/templates/production.conf /etc/simple-metricd/simple-metricd.conf; fi"
        remote "sudo systemctl daemon-reload"
        echo "Set root_password and TLS, then: vagrant ssh -c 'sudo systemctl enable --now simple-metricd'"
        ;;
    status)
        echo "Checking service status..."
        remote "sudo systemctl status simple-metricd --no-pager"
        ;;
    logs)
        echo "Showing service logs..."
        remote "sudo journalctl -u simple-metricd -n 50 --no-pager"
        ;;
    build)
        echo "Building project..."
        remote "mkdir -p $PROJECT_DIR/build && cd $PROJECT_DIR/build && sudo -u $BUILD_USER cmake .. $CMAKE_FLAGS && sudo -u $BUILD_USER make -j\$(nproc)"
        ;;
    *)
        echo "Usage: $0 [vm_name] [clean|test|install|status|logs|build]"
        exit 1
        ;;
esac
