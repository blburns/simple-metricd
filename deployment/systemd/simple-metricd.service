[Unit]
Description=Simple Metrics Daemon
Documentation=https://github.com/SimpleDaemons/simple-metricd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simple-metricd
Group=simple-metricd
ExecStart=/usr/bin/simple-metricd --config /etc/simple-metricd/simple-metricd.conf --foreground
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=simple-metricd

# systemd creates these as simple-metricd:simple-metricd under /var/lib and /var/log
StateDirectory=simple-metricd
LogsDirectory=simple-metricd
ConfigurationDirectory=simple-metricd
WorkingDirectory=/var/lib/simple-metricd
ReadWritePaths=/var/lib/simple-metricd /var/log/simple-metricd

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
